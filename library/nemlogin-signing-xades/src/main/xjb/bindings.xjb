<?xml version="1.0"?>
<jxb:bindings version="3.0"
              xmlns:jxb="https://jakarta.ee/xml/ns/jaxb"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xmlns:namespace="urn:jaxb.jvnet.org:plugin:namespace-prefix"
              xsi:schemaLocation="http://java.sun.com/xml/ns/jaxb http://java.sun.com/xml/ns/jaxb/bindingschema_2_0.xsd
              urn:jaxb.jvnet.org:plugin:namespace-prefix http://java.net/projects/jaxb2-commons/sources/svn/content/namespace-prefix/trunk/src/main/resources/prefix-namespace-schema.xsd">

    <jxb:bindings schemaLocation="../resources/xsd/xmldsig-core-schema.xsd">
        <jxb:bindings>
            <namespace:prefix name="ds" />
        </jxb:bindings>
    </jxb:bindings>
    <jxb:bindings schemaLocation="../resources/xsd/nemlogin-signed-document.xsd">
        <jxb:bindings>
            <namespace:prefix name="" />
        </jxb:bindings>
    </jxb:bindings>
</jxb:bindings>
